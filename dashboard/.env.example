# Alumni Founder Dashboard - Environment Variables
# Copy this to .env and fill in your API keys

# ── Required for Alumni Discovery ─────────────────────────────────────────────
# Serper.dev - 2,500 free Google searches/month (serper.dev)
SERPER_API_KEY=your_serper_api_key

# ── Optional Data Sources ─────────────────────────────────────────────────────

# People Data Labs - 100 free lookups/month (peopledatalabs.com/signup)
# PDL_API_KEY=your_pdl_key

# Product Hunt - 500 free requests/day (producthunt.com/v2/oauth/applications)
# PRODUCTHUNT_TOKEN=your_ph_token

# LinkedIn via Proxycurl - $0.01/lookup (nubela.co/proxycurl)
# PROXYCURL_API_KEY=your_proxycurl_key

# UK Companies House - Free (developer.company-information.service.gov.uk)
# COMPANIES_HOUSE_API_KEY=your_ch_key

# Australian Business Register - Free (abr.business.gov.au)
# ABR_GUID=your_abr_guid

# GitHub - Optional, increases rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_xxx

# Crunchbase - From $29/month (crunchbase.com/platform)
# CRUNCHBASE_API_KEY=your_cb_key

# Apollo.io - 600 free people searches/day (apollo.io)
# APOLLO_API_KEY=your_apollo_key

# OpenCorporates - 200 free searches/month without key (opencorporates.com)
# OPENCORPORATES_API_KEY=your_oc_key

# ── Free Sources (no API keys needed) ────────────────────────────────────────
# These sources work without any configuration:
# - Hacker News (via hn.algolia.com/api)
# - Google News RSS (via news.google.com/rss)
# - Y Combinator Companies (via yc-oss.github.io/api)
# - OpenCorporates basic search (200/month unauthenticated)

# ── Server Config ─────────────────────────────────────────────────────────────
# PORT=3001
# HOST=0.0.0.0
